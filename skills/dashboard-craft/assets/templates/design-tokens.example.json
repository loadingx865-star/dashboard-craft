{
  "$schema": "https://design-tokens.org/schema.json",
  "_comment": "示例起始集。按项目在阶段 1 扩展。三层：primitive -> semantic -> component。上层只引用下层。",

  "primitive": {
    "blue":   { "500": "#3B82F6", "600": "#2563EB", "900": "#1E3A8A" },
    "slate":  { "50": "#F8FAFC", "300": "#CBD5E1", "500": "#64748B", "700": "#334155", "900": "#0F172A" },
    "green":  { "500": "#22C55E" },
    "amber":  { "500": "#F59E0B" },
    "red":    { "500": "#EF4444" },
    "cyan":   { "400": "#22D3EE" },
    "purple": { "500": "#A855F7" }
  },

  "semantic": {
    "color-bg-canvas":   { "$value": "{primitive.slate.900}", "$type": "color" },
    "color-bg-surface":  { "$value": "{primitive.slate.700}", "$type": "color" },
    "color-text-primary":{ "$value": "{primitive.slate.50}",  "$type": "color" },
    "color-text-muted":  { "$value": "{primitive.slate.300}", "$type": "color" },
    "color-border":      { "$value": "{primitive.slate.500}", "$type": "color" },
    "color-status-ok":     { "$value": "{primitive.green.500}", "$type": "color" },
    "color-status-warn":   { "$value": "{primitive.amber.500}", "$type": "color" },
    "color-status-alarm":  { "$value": "{primitive.red.500}",   "$type": "color" },
    "color-status-offline":{ "$value": "{primitive.slate.500}", "$type": "color" },

    "font-size-metric": { "$value": "3rem",    "$type": "dimension" },
    "font-size-xl":     { "$value": "2rem",    "$type": "dimension" },
    "font-size-lg":     { "$value": "1.5rem",  "$type": "dimension" },
    "font-size-md":     { "$value": "1.125rem","$type": "dimension" },
    "font-size-base":   { "$value": "1rem",    "$type": "dimension" },
    "font-size-sm":     { "$value": "0.875rem","$type": "dimension" },

    "space-1": { "$value": "4px",  "$type": "dimension" },
    "space-2": { "$value": "8px",  "$type": "dimension" },
    "space-3": { "$value": "12px", "$type": "dimension" },
    "space-4": { "$value": "16px", "$type": "dimension" },
    "space-6": { "$value": "24px", "$type": "dimension" },
    "space-8": { "$value": "32px", "$type": "dimension" },

    "radius-sm": { "$value": "4px",  "$type": "dimension" },
    "radius-md": { "$value": "8px",  "$type": "dimension" },

    "z-content": { "$value": 1,  "$type": "number" },
    "z-dropdown":{ "$value": 10, "$type": "number" },
    "z-overlay": { "$value": 100,"$type": "number" },
    "z-toast":   { "$value": 1000,"$type": "number" }
  },

  "component": {
    "card-bg":         { "$value": "{semantic.color-bg-surface}", "$type": "color" },
    "card-radius":     { "$value": "{semantic.radius-md}",        "$type": "dimension" },
    "card-padding":    { "$value": "{semantic.space-4}",          "$type": "dimension" },

    "_comment_chart": "图表色板固定顺序，禁止页面自定义",
    "chart-series-1":  { "$value": "{primitive.cyan.400}",   "$type": "color" },
    "chart-series-2":  { "$value": "{primitive.blue.500}",   "$type": "color" },
    "chart-series-3":  { "$value": "{primitive.green.500}",  "$type": "color" },
    "chart-series-4":  { "$value": "{primitive.amber.500}",  "$type": "color" },
    "chart-series-5":  { "$value": "{primitive.purple.500}", "$type": "color" },
    "chart-series-6":  { "$value": "{primitive.red.500}",    "$type": "color" },

    "chart-axis-color":  { "$value": "{semantic.color-border}",       "$type": "color" },
    "chart-label-color": { "$value": "{semantic.color-text-muted}",    "$type": "color" },
    "chart-label-size":  { "$value": "{semantic.font-size-sm}",        "$type": "dimension" }
  }
}
