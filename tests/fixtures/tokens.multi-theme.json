{
  "primitive": {
    "blue":  { "500": "#3B82F6" },
    "slate": { "50": "#F8FAFC", "300": "#CBD5E1", "500": "#64748B", "900": "#0F172A" },
    "green": { "500": "#22C55E" },
    "amber": { "500": "#F59E0B" },
    "red":   { "500": "#EF4444" },
    "cyan":  { "400": "#22D3EE" }
  },
  "themes": {
    "dark": {
      "semantic": {
        "color": {
          "bg": { "canvas": { "$value": "{primitive.slate.900}" }, "surface": { "$value": "{primitive.slate.500}" } },
          "text": { "primary": { "$value": "{primitive.slate.50}" }, "muted": { "$value": "{primitive.slate.300}" } },
          "border": { "$value": "{primitive.slate.500}" },
          "status": {
            "ok": { "$value": "{primitive.green.500}" }, "warn": { "$value": "{primitive.amber.500}" },
            "alarm": { "$value": "{primitive.red.500}" }, "offline": { "$value": "{primitive.slate.500}" }
          }
        },
        "font-size": { "metric": { "$value": "3rem" }, "base": { "$value": "1rem" } },
        "chart-series-1": { "$value": "{primitive.cyan.400}" },
        "chart-series-2": { "$value": "{primitive.blue.500}" },
        "chart-series-3": { "$value": "{primitive.green.500}" }
      },
      "component": { "card-bg": { "$value": "{semantic.color.bg.surface}" } }
    },
    "light": {
      "semantic": {
        "color": {
          "bg": { "canvas": { "$value": "#FFFFFF" }, "surface": { "$value": "#F1F5F9" } },
          "text": { "primary": { "$value": "#0F172A" }, "muted": { "$value": "#64748B" } },
          "border": { "$value": "#CBD5E1" },
          "status": {
            "ok": { "$value": "#16A34A" }, "warn": { "$value": "#D97706" },
            "alarm": { "$value": "#DC2626" }, "offline": { "$value": "#94A3B8" }
          }
        },
        "font-size": { "metric": { "$value": "3rem" }, "base": { "$value": "1rem" } },
        "chart-series-1": { "$value": "#0891B2" },
        "chart-series-2": { "$value": "#2563EB" },
        "chart-series-3": { "$value": "#16A34A" }
      },
      "component": { "card-bg": { "$value": "{semantic.color.bg.surface}" } }
    }
  }
}
